// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
  {
    "label": "Select Debug Rayconf",
    "adapter": "CodeLLDB",
    "build": {
      "command": "cargo",
      "args": ["build"],
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/rayconf",
    "request": "launch",
    "args": ["select", "--remote"],
  },

  {
    "label": "Perf Debug Rayconf",
    "adapter": "CodeLLDB",
    "build": {
      "command": "cargo",
      "args": ["build"],
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/rayconf",
    "request": "launch",
    "args": ["perf"],
  },
]
